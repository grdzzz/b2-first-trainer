{
  "name": "b2-first-trainer",
  "productName": "B2 First Trainer",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para practicar el examen Cambridge B2 First con tus propios materiales.",
  "author": "B2 First Trainer",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win portable nsis --x64",
    "build:linux-dir": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "lucide-react": "1.74.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.3.3",
    "electron-builder": "26.0.20",
    "electron-vite": "3.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
