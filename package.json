{
  "name": "b2-first-trainer",
  "productName": "B2 First Trainer",
  "version": "1.9.2",
  "description": "Aplicación de escritorio para practicar el examen Cambridge B2 First con tus propios materiales.",
  "author": "B2 First Trainer",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "build:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "build:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "3.1.0",
    "lucide-react": "1.74.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resedit": "2.0.3",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "5.1.1"
  },
  "build": {
    "appId": "local.b2firsttrainer.app",
    "productName": "B2 First Trainer",
    "copyright": "Uso personal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/renderer/assets/*.wasm",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "es",
      "es-419",
      "en-US",
      "en-GB"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "B2-First-Trainer-Windows-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B2 First Trainer",
      "artifactName": "B2-First-Trainer-Windows-Setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "b2-first-trainer",
      "category": "Education",
      "artifactName": "B2-First-Trainer-Linux.${ext}",
      "synopsis": "Práctica del examen Cambridge B2 First"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/grdzzz/b2-first-trainer/descargas",
        "channel": "latest"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "node_modules/onnxruntime-web/dist",
        "to": "ort",
        "filter": [
          "ort-wasm-simd-threaded.jsep.wasm",
          "ort-wasm-simd-threaded.jsep.mjs"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/example",
        "to": "example",
        "filter": [
          "*.pdf",
          "*.mp3"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "B2-First-Trainer-macOS-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "B2 First Trainer usa el micrófono para grabar tus respuestas de Speaking."
      }
    },
    "dmg": {
      "title": "B2 First Trainer ${version}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "overrides": {
    "onnxruntime-node": "file:./stubs/empty",
    "sharp": "file:./stubs/empty"
  }
}
