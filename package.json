{
  "name": "b2-first-trainer",
  "productName": "B2 First Trainer",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para practicar el examen Cambridge B2 First con tus propios materiales.",
  "author": "B2 First Trainer",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "build:linux-dir": "npm run build && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.3.3",
    "electron-builder": "26.0.20",
    "electron-vite": "3.1.0",
    "lucide-react": "1.74.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "local.b2firsttrainer.app",
    "productName": "B2 First Trainer",
    "copyright": "Uso personal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "es",
      "es-419",
      "en-US",
      "en-GB"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "B2-First-Trainer-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B2 First Trainer",
      "artifactName": "B2-First-Trainer-${version}-setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    }
  }
}
